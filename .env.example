# SQLite DB file path (created automatically on first run, migrations applied on startup)
DATABASE_PATH=./data.db

# Optional: where the drizzle/ migrations directory lives. Defaults to
# <current working directory>/drizzle — only set this if you run the app
# from somewhere other than the project root.
#MIGRATIONS_PATH=/opt/server-manager/drizzle

# systemctl driver mode: "mock" (Windows/dev, in-memory fake state) or "real" (Linux, execFile systemctl)
SYSTEMCTL_MODE=mock

# Discord bot token. Leave unset to skip bot startup entirely (web UI works without it).
DISCORD_TOKEN=

# Required by adapter-node's CSRF protection. Must match the externally visible
# origin (scheme + host only, NO subpath), e.g. https://example.com
ORIGIN=http://localhost:5173

# Port the built Node server listens on (adapter-node "build/index.js" respects this)
PORT=5173

# --- Reverse proxy (optional) ------------------------------------------------
# Context path for serving under a subpath, e.g. https://example.com/server-manager/.
# BUILD-TIME only: set before `npm run build` and rebuild to change it. Must start
# with '/' and not end with '/'. Empty/unset = served at root '/'.
#BASE_PATH=/server-manager

# Behind a TLS-terminating reverse proxy, let adapter-node derive the external
# protocol/host from the proxy's X-Forwarded-* headers (needed for Secure cookies
# and CSRF). See deploy/nginx.conf.example.
#PROTOCOL_HEADER=x-forwarded-proto
#HOST_HEADER=x-forwarded-host
